FROM nikolaik/python-nodejs:python3.12-nodejs22-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=/api

WORKDIR /app

COPY apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /app/apps/api/requirements.txt
COPY apps/api /app/apps/api
COPY apps/web/package.json apps/web/package-lock.json /app/apps/web/
RUN cd /app/apps/web && npm ci --omit=dev --no-audit --no-fund
COPY apps/web /app/apps/web
ENV PYTHONPATH=/app/apps/api

COPY scripts/start-creatorshield-3c.sh /usr/local/bin/start-creatorshield-3c
RUN chmod +x /usr/local/bin/start-creatorshield-3c \
    && mkdir -p /data/uploads

EXPOSE 3000
CMD ["/usr/local/bin/start-creatorshield-3c"]
